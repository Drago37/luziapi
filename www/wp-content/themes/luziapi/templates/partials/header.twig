{% set home = function('home_url', '/') %}
{% set shop = function('wc_get_page_permalink', 'shop') %}
<header class="site-header">
    <div class="wrap nav">
        <a class="brand" href="{{ home }}">
            <svg class="bee" viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <ellipse cx="12" cy="20" rx="9" ry="6" fill="#f7dd9b" opacity="0.8" transform="rotate(-26 12 20)"/>
                <ellipse cx="36" cy="20" rx="9" ry="6" fill="#f7dd9b" opacity="0.8" transform="rotate(26 36 20)"/>
                <clipPath id="beebody"><ellipse cx="24" cy="33" rx="11" ry="15"/></clipPath>
                <ellipse cx="24" cy="33" rx="11" ry="15" fill="#e0a124"/>
                <g clip-path="url(#beebody)" fill="#2b1d10">
                    <rect x="11" y="25" width="26" height="4.4"/>
                    <rect x="11" y="34" width="26" height="4.4"/>
                    <rect x="11" y="43" width="26" height="4.4"/>
                </g>
                <circle cx="24" cy="14" r="6.4" fill="#2b1d10"/>
                <path d="M21 9 Q18 4 15.5 4.2" stroke="#2b1d10" stroke-width="1.6" fill="none" stroke-linecap="round"/>
                <path d="M27 9 Q30 4 32.5 4.2" stroke="#2b1d10" stroke-width="1.6" fill="none" stroke-linecap="round"/>
                <circle cx="15.5" cy="4" r="1.5" fill="#2b1d10"/><circle cx="32.5" cy="4" r="1.5" fill="#2b1d10"/>
            </svg>
            <span class="wm">Luzi<b>Api</b></span>
        </a>

        <div class="nav-right">
            <nav class="menu">
                <a href="{{ home }}#apiculteur">L'apiculteur</a>
                <a href="{{ home }}#savoir-faire">Savoir-faire</a>
                <a href="{{ home }}#produits">Nos miels</a>
                <a href="{{ home }}#actualites">Actualités</a>
                <a href="{{ home }}#localisation">Nous trouver</a>
                <a href="{{ home }}#contact">Contact</a>
                <a class="btn btn-soft" href="{{ home }}#newsletter"><svg class="btn-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm6-6V11c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 0 0-3 0v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg> S'abonner</a>
                <a class="btn btn-sos" href="{{ home }}recuperation-essaims/"><span class="btn-emoji" aria-hidden="true">🐝</span> SOS&nbsp;Essaim</a>
                <a class="btn btn-gold" href="{{ shop ?: (home ~ '#produits') }}"><svg class="btn-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM7.2 14.6l.03-.12.9-1.64h6.45c.75 0 1.4-.41 1.74-1.03l3.58-6.49-1.74-.96-3.58 6.49H8.53L4.27 2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7.42c-.13 0-.23-.11-.22-.4z"/></svg> Boutique</a>
                {% if contact.facebook %}<a class="btn btn-fb" href="{{ contact.facebook }}" target="_blank" rel="noopener"><svg class="btn-ic" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.3l.35-2.7H13.5V9.6c0-.78.22-1.3 1.33-1.3h1.42V5.9c-.25-.03-1.1-.1-2.08-.1-2.06 0-3.47 1.26-3.47 3.57v1.98H8.4V14h2.3v7h2.8z"/></svg> Facebook</a>{% endif %}
