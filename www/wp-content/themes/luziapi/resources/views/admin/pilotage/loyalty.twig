<div class="wrap luziapi-pilotage">
    <div class="luziapi-pilotage__header">
        <div>
            <p class="luziapi-pilotage__eyebrow">Programme « 10 pots achetés, le 11e offert »</p>
            <h1>Fidélité {{ year }}</h1>
            <p>Récapitulatif par client et classements de l’année — pots achetés, pots offerts et remises remerciement.</p>
        </div>
        {% if available_years|length > 1 %}
            <div class="luziapi-pilotage__year-picker">
                <span>Année</span>
                {% for item in available_years %}<a class="{{ item.year == year ? 'is-active' : '' }}" href="{{ item.url|e('html_attr') }}">{{ item.year }}</a>{% endfor %}
            </div>
        {% endif %}
    </div>

    <nav class="nav-tab-wrapper" aria-label="Sections du tableau de pilotage">
        <a class="nav-tab" href="{{ dashboard_url|e('html_attr') }}">Vue d’ensemble</a>
        <a class="nav-tab" href="{{ receipts_url|e('html_attr') }}">Recettes</a>
        <a class="nav-tab" href="{{ tax_declaration_url|e('html_attr') }}">Déclaration fiscale</a>
        <a class="nav-tab" href="{{ orders_url|e('html_attr') }}">Commandes</a>
        <a class="nav-tab" href="{{ customers_url|e('html_attr') }}">Clients</a>
        <a class="nav-tab nav-tab-active" href="{{ page_url|e('html_attr') }}">Fidélité</a>
        <a class="nav-tab" href="{{ products_url|e('html_attr') }}">Produits</a>
        <a class="nav-tab" href="{{ inventory_url|e('html_attr') }}">Stocks et lots</a>
        <a class="nav-tab" href="{{ quick_sale_url|e('html_attr') }}">Vente</a>
        <a class="nav-tab" href="{{ activity_url|e('html_attr') }}">Journal d’activité</a>
    </nav>

    <div class="luziapi-pilotage__metrics">
        {% for metric in metrics %}
            <div class="luziapi-pilotage__metric"><span>{{ metric.label|e }}</span><strong>{{ metric.value|e }}</strong></div>
        {% endfor %}
    </div>

    {% if customers is empty %}
        <section class="luziapi-pilotage__panel">
            <p>Aucune activité de fidélité en {{ year }}. Les pots se comptent dès qu’une commande « Terminée » contient des produits cochés « Pot admissible à la fidélité ».</p>
        </section>
    {% else %}
        <div class="luziapi-pilotage__grid">
            <section class="luziapi-pilotage__panel">
                <p class="luziapi-pilotage__eyebrow">🏆 Meilleurs clients</p>
                <h2>Plus de pots achetés</h2>
                <ol class="luziapi-pilotage__ranking">
                    {% for row in top_buyers %}<li><a href="{{ row.details_url|e('html_attr') }}">{{ row.name|e }}</a><strong>{{ row.pots_bought }} pots</strong></li>{% else %}<li>—</li>{% endfor %}
                </ol>
            </section>
            <section class="luziapi-pilotage__panel">
                <p class="luziapi-pilotage__eyebrow">🎁 Ont le plus profité</p>
                <h2>Plus de pots offerts reçus</h2>
                <ol class="luziapi-pilotage__ranking">
                    {% for row in top_benefited %}<li><a href="{{ row.details_url|e('html_attr') }}">{{ row.name|e }}</a><strong>{{ row.offered_pots }} pots</strong></li>{% else %}<li>Aucun pot offert pour l’instant.</li>{% endfor %}
                </ol>
            </section>
            <section class="luziapi-pilotage__panel">
                <p class="luziapi-pilotage__eyebrow">💶 Plus de remises</p>
                <h2>Remise remerciement reçue</h2>
                <ol class="luziapi-pilotage__ranking">
                    {% for row in top_discounts %}<li><a href="{{ row.details_url|e('html_attr') }}">{{ row.name|e }}</a><strong>{{ row.discount|e }}</strong></li>{% else %}<li>Aucune remise pour l’instant.</li>{% endfor %}
                </ol>
            </section>
        </div>

        <section class="luziapi-pilotage__panel">
            <div class="luziapi-pilotage__panel-header">
                <div><p class="luziapi-pilotage__eyebrow">Récapitulatif</p><h2>{{ customers|length }} client{{ customers|length > 1 ? 's' : '' }} fidélité</h2></div>
            </div>
            <div class="luziapi-pilotage__table-wrap">
                <table class="widefat striped">
                    <thead><tr><th>Client</th><th>Ville</th><th>Pots achetés</th><th>Pots offerts reçus</th><th>Remises reçues</th></tr></thead>
                    <tbody>
                    {% for row in customers %}
                        <tr>
                            <td><a href="{{ row.details_url|e('html_attr') }}"><strong>{{ row.name|e }}</strong></a></td>
                            <td>{{ row.city|e }}</td>
                            <td>{{ row.pots_bought }}</td>
                            <td>{{ row.offered_pots }}</td>
                            <td>{{ row.discount|e }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
</div>
