<div class="wrap luziapi-pilotage">
    <div class="luziapi-pilotage__header"><div><p class="luziapi-pilotage__eyebrow">Miels et récoltes</p><h1>Produits et stocks</h1><p>Suivre les pots vendus, le chiffre d’affaires et le stock disponible.</p></div><a class="page-title-action" href="{{ products_admin_url|e('html_attr') }}">Gérer les produits</a></div>
    <nav class="nav-tab-wrapper" aria-label="Sections du tableau de pilotage"><a class="nav-tab" href="{{ dashboard_url|e('html_attr') }}">Vue d’ensemble</a><a class="nav-tab" href="{{ receipts_url|e('html_attr') }}">Recettes</a><a class="nav-tab" href="{{ tax_declaration_url|e('html_attr') }}">Déclaration fiscale</a><a class="nav-tab" href="{{ orders_url|e('html_attr') }}">Commandes</a><a class="nav-tab" href="{{ customers_url|e('html_attr') }}">Clients</a><a class="nav-tab" href="{{ loyalty_url|e('html_attr') }}">Fidélité</a><a class="nav-tab nav-tab-active" href="{{ page_url|e('html_attr') }}">Produits</a><a class="nav-tab" href="{{ inventory_url|e('html_attr') }}">Stocks et lots</a><a class="nav-tab" href="{{ quick_sale_url|e('html_attr') }}">Vente</a><a class="nav-tab" href="{{ activity_url|e('html_attr') }}">Journal d’activité</a></nav>
    <form class="luziapi-pilotage__period" action="{{ page_url|e('html_attr') }}" method="get"><input type="hidden" name="page" value="luziapi-pilotage"><input type="hidden" name="tab" value="products"><label for="luziapi-products-year">Année</label><select id="luziapi-products-year" name="year" onchange="this.form.submit()">{% for available_year in available_years %}<option value="{{ available_year }}" {{ available_year == year ? 'selected' : '' }}>{{ available_year }}</option>{% endfor %}</select></form>
    <section class="luziapi-pilotage__metrics luziapi-pilotage__metrics--four">{% for metric in metrics %}<article class="luziapi-pilotage__metric"><span>{{ metric.label|e }}</span><strong>{{ metric.value|e }}</strong></article>{% endfor %}</section>
    <div class="luziapi-pilotage__grid">
        <section class="luziapi-pilotage__panel luziapi-pilotage__panel--wide"><p class="luziapi-pilotage__eyebrow">Ventes {{ year }}</p><h2>Pots vendus par variété</h2><div class="luziapi-pilotage__chart"><canvas id="luziapi-products-chart" data-labels="{{ chart_labels|json_encode|e('html_attr') }}" data-values="{{ chart_values|json_encode|e('html_attr') }}" aria-label="Pots vendus par variété en {{ year }}" role="img"></canvas></div></section>
        <section class="luziapi-pilotage__panel luziapi-pilotage__panel--wide"><p class="luziapi-pilotage__eyebrow">Catalogue</p><h2>Performance et stock</h2><div class="luziapi-pilotage__table-wrap"><table class="widefat striped"><thead><tr><th>Produit</th><th>SKU</th><th>Pots vendus</th><th>CA produit</th><th>Stock</th><th>État</th></tr></thead><tbody>{% for product in products %}<tr><td><a href="{{ product.edit_url|e('html_attr') }}"><strong>{{ product.name|e }}</strong></a></td><td>{{ product.sku ? product.sku|e : '—' }}</td><td>{{ product.sold }}</td><td>{{ product.revenue|e }}</td><td>{{ product.stock is null ? 'Non suivi' : product.stock }}</td><td>{% if product.low_stock %}<span class="luziapi-pilotage__badge is-warning">Stock faible</span>{% else %}<span class="luziapi-pilotage__badge is-ok">OK</span>{% endif %}</td></tr>{% else %}<tr><td colspan="6">Aucun produit trouvé.</td></tr>{% endfor %}</tbody></table></div></section>
    </div>
</div>
