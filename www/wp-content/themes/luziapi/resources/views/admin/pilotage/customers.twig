<div class="wrap luziapi-pilotage">
    <div class="luziapi-pilotage__header">
        <div>
            <p class="luziapi-pilotage__eyebrow">Carnet client</p>
            <h1>Clients et historique</h1>
            <p>Historique construit depuis les commandes, sans créer de compte ni de consentement marketing.</p>
        </div>
        <a class="page-title-action" href="{{ new_order_url|e('html_attr') }}">Ajouter une commande</a>
    </div>

    {% include '@luziapi_admin/pilotage/_nav.twig' %}

    {% if notice == 'category_updated' %}<div class="notice notice-success inline"><p>La catégorie du client a été enregistrée.</p></div>{% endif %}
    {% if notice == 'category_error' %}<div class="notice notice-error inline"><p>La catégorie n’a pas pu être enregistrée. Recharge la fiche et réessaie.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'discount_applied' %}<div class="notice notice-success inline"><p>La remise remerciement a été appliquée à la commande.</p></div>{% endif %}
    {% if notice == 'discount_error' %}<div class="notice notice-error inline"><p>La remise remerciement n’a pas pu être appliquée. Vérifie la commande et le montant.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'pots_adjusted' %}<div class="notice notice-success inline"><p>Le solde de pots a été ajusté.</p></div>{% endif %}
    {% if notice == 'profile_updated' %}<div class="notice notice-success inline"><p>La fiche du client a été enregistrée.</p></div>{% endif %}
    {% if notice == 'profile_error' %}<div class="notice notice-error inline"><p>La fiche n’a pas pu être enregistrée.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'subscription_updated' %}<div class="notice notice-success inline"><p>L’abonnement a été mis à jour dans Brevo.{% if notice_detail %} <strong>{{ notice_detail|e }}</strong>{% endif %}</p></div>{% endif %}
    {% if notice == 'subscription_error' %}<div class="notice notice-error inline"><p>L’abonnement n’a pas pu être mis à jour.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'pots_error' %}<div class="notice notice-error inline"><p>L’ajustement des pots a échoué. Vérifie la quantité saisie.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'customers_merged' %}<div class="notice notice-success inline"><p>Les deux clients ont été fusionnés : leurs pots sont désormais regroupés.</p></div>{% endif %}
    {% if notice == 'merge_error' %}<div class="notice notice-error inline"><p>La fusion des clients a échoué. Recharge la fiche et réessaie.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}
    {% if notice == 'customer_unlinked' %}<div class="notice notice-success inline"><p>Ce client a été détaché du regroupement : ses pots ne sont plus agrégés avec les autres.</p></div>{% endif %}
    {% if notice == 'unlink_error' %}<div class="notice notice-error inline"><p>La défusion a échoué. Recharge la fiche et réessaie.</p>{% if notice_detail %}<p><strong>Détail&nbsp;:</strong> <code>{{ notice_detail|e }}</code></p>{% endif %}</div>{% endif %}

    {% if selected_customer %}
        <section class="luziapi-pilotage__customer-card">
            <div class="luziapi-pilotage__panel-header">
                <div>
                    <p class="luziapi-pilotage__eyebrow">Fiche client</p>
                    <h2>{{ selected_customer.name|e }}</h2>
                    {% if selected_customer.city %}<p>{{ selected_customer.city|e }}</p>{% endif %}
                </div>
                <div class="luziapi-pilotage__panel-actions">
                    <a class="button button-primary" href="{{ new_order_for_customer_url|e('html_attr') }}">Créer une vente pour ce client</a>
                    <a class="button" href="{{ page_url|e('html_attr') }}">Fermer la fiche</a>
                </div>
            </div>
            <div class="luziapi-pilotage__customer-summary">
                <div><span>Commandes validées</span><strong>{{ selected_customer.orders_count }}</strong></div>
                <div><span>Total commandé</span><strong>{{ selected_customer.total|e }}</strong></div>
                <div><span>Total encaissé</span><strong>{{ selected_customer.collected|e }}</strong></div>
                <div>
                    <span>Coordonnées</span>
                    {% for email in selected_customer.emails %}<a href="mailto:{{ email|e('html_attr') }}">{{ email|e }}</a>{% endfor %}
                    {% for phone in selected_customer.phones %}<a href="tel:{{ phone.href|e('html_attr') }}">{{ phone.label|e }}</a>{% endfor %}
                </div>
                {% set b = selected_customer.billing %}
                {% if b.address_1 or b.postcode or b.company %}
                <div>
                    <span>Adresse postale</span>
                    {% if b.company %}<strong>{{ b.company|e }}</strong><br>{% endif %}
                    {% if b.address_1 %}{{ b.address_1|e }}<br>{% endif %}
                    {% if b.address_2 %}{{ b.address_2|e }}<br>{% endif %}
                    {{ (b.postcode ~ ' ' ~ b.city)|trim|e }}{% if b.country and b.country != 'FR' %}<br>{{ b.country|e }}{% endif %}
                </div>
                {% endif %}
            </div>
            <div class="luziapi-pilotage__customer-insights">
                <p><strong>Produits habituels :</strong> {{ selected_customer.products ? selected_customer.products|join(', ')|e : 'Pas encore assez de données' }}</p>
                <p><strong>Sources :</strong> {{ selected_customer.sources ? selected_customer.sources|join(', ')|e : 'Non renseignée' }}</p>
                {% if selected_customer.subscription.available %}
                    {% set sub = selected_customer.subscription %}
                    {% if sub.writable and sub.known %}
                        <form action="{{ action_url|e('html_attr') }}" method="post" style="margin-top:6px">
                            <input type="hidden" name="action" value="luziapi_update_subscription">
                            <input type="hidden" name="_wpnonce" value="{{ subscription_nonce|e('html_attr') }}">
                            <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                            <p style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin:0">
                                <strong>Abonnements :</strong>
                                <label style="display:inline-flex;align-items:center;gap:6px"><input type="checkbox" name="sub_email" {{ sub.email ? 'checked' : '' }}> Newsletter e-mail</label>
                                <label style="display:inline-flex;align-items:center;gap:6px"><input type="checkbox" name="sub_sms" {{ sub.sms ? 'checked' : '' }} {{ sub.has_phone ? '' : 'disabled' }}> SMS</label>
                                <button type="submit" class="button">Enregistrer l’abonnement</button>
                                <span class="description">écrit directement dans Brevo · cocher inscrit, décocher désinscrit</span>
                            </p>
                            {% if not sub.has_phone %}<span class="description">Ajoutez un mobile à la fiche pour activer l’abonnement SMS.</span>{% endif %}
                        </form>
                    {% elseif sub.writable and not sub.known %}
                        <form action="{{ action_url|e('html_attr') }}" method="post" style="margin-top:6px">
                            <input type="hidden" name="action" value="luziapi_update_subscription">
                            <input type="hidden" name="_wpnonce" value="{{ subscription_nonce|e('html_attr') }}">
                            <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                            <input type="hidden" name="sub_email" value="1">
                            {% if sub.has_phone %}<input type="hidden" name="sub_sms" value="1">{% endif %}
                            <p style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:0">
                                <strong>Abonnements :</strong>
                                <span class="description">pas encore dans Brevo.</span>
                                <button type="submit" class="button button-primary">Ajouter dans Brevo</button>
                                <span class="description">crée le contact depuis la fiche (nom, prénom, e-mail{{ sub.has_phone ? ', mobile SMS' : '' }}) et l’inscrit à la newsletter.</span>
                            </p>
                        </form>
                    {% else %}
                        <p style="display:flex;flex-wrap:wrap;align-items:center;gap:14px">
                            <strong>Abonnements :</strong>
                            <label style="display:inline-flex;align-items:center;gap:6px"><input type="checkbox" disabled {{ sub.email ? 'checked' : '' }}> Newsletter e-mail</label>
                            <label style="display:inline-flex;align-items:center;gap:6px"><input type="checkbox" disabled {{ sub.sms ? 'checked' : '' }}> SMS</label>
                            <span class="description">gestion impossible sans e-mail sur la fiche.</span>
                        </p>
                    {% endif %}
                {% endif %}
            </div>
            {% set b = selected_customer.billing %}
            <form class="luziapi-pilotage__customer-profile-form" action="{{ action_url|e('html_attr') }}" method="post" style="margin-top:14px;padding:14px;border:1px solid #dcdcde;border-radius:6px">
                <input type="hidden" name="action" value="luziapi_save_customer_profile">
                <input type="hidden" name="_wpnonce" value="{{ profile_nonce|e('html_attr') }}">
                <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                <p class="luziapi-pilotage__eyebrow" style="margin:0 0 6px">Modifier la fiche client</p>
                <style>.luziapi-profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:782px){.luziapi-profile-grid{grid-template-columns:1fr}}</style>
                <div class="luziapi-profile-grid">
                    <label style="display:flex;flex-direction:column;font-size:12px">Prénom
                        <input type="text" name="billing_first_name" value="{{ b.first_name|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Nom
                        <input type="text" name="billing_last_name" value="{{ b.last_name|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Société <span class="description">(facultatif)</span>
                        <input type="text" name="billing_company" value="{{ b.company|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">E-mail
                        <input type="email" name="billing_email" value="{{ b.email|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Téléphone
                        <input type="text" name="billing_phone" value="{{ b.phone|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px;grid-column:1/-1">Adresse
                        <input type="text" name="billing_address_1" value="{{ b.address_1|e('html_attr') }}" autocomplete="off" data-luziapi-address="1" data-luziapi-address-nonce="{{ address_nonce|e('html_attr') }}" placeholder="Commencez à taper puis choisissez une suggestion">
                        <span class="description" data-luziapi-address-hint>Suggestions officielles (Base Adresse Nationale) : un clic remplit code postal et ville.</span></label>
                    <label style="display:flex;flex-direction:column;font-size:12px;grid-column:1/-1">Complément d’adresse <span class="description">(facultatif)</span>
                        <input type="text" name="billing_address_2" value="{{ b.address_2|e('html_attr') }}"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Code postal
                        <input type="text" name="billing_postcode" value="{{ b.postcode|e('html_attr') }}" data-luziapi-postcode></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Ville
                        <input type="text" name="billing_city" value="{{ b.city|e('html_attr') }}" data-luziapi-city></label>
                    <label style="display:flex;flex-direction:column;font-size:12px">Pays
                        <input type="text" name="billing_country" value="{{ b.country|e('html_attr') }}" maxlength="2" style="text-transform:uppercase" placeholder="FR"></label>
                    <label style="display:flex;flex-direction:column;font-size:12px;grid-column:1/-1">Catégorie du client
                        <select name="category">{% for category in categories %}<option value="{{ category.value|e('html_attr') }}" {{ category.value == selected_customer.category_key ? 'selected' : '' }}>{{ category.label|e }}</option>{% endfor %}</select></label>
                </div>
                <div style="margin-top:10px;display:flex;align-items:center;gap:10px">
                    <button type="submit" class="button button-primary">Enregistrer la fiche</button>
                    {% if not b.has_override %}<span class="description">Prérempli depuis la dernière commande. L’enregistrement crée une fiche dédiée.</span>{% endif %}
                </div>
                <p class="description" style="margin-top:8px">La fiche est la donnée de référence du client : elle <strong>ne réécrit pas</strong> les commandes passées (factures préservées). Pour corriger une commande précise, ouvrez-la depuis l’historique ci-dessous.</p>
            </form>

            {% if selected_customer.loyalty %}
                {% set loyalty = selected_customer.loyalty %}
                <div class="luziapi-pilotage__loyalty">
                    <h3>Fidélité</h3>
                    <div class="luziapi-pilotage__customer-summary">
                        <div><span>Pots fidélité</span><strong>{{ loyalty.net_pots }}</strong></div>
                        <div><span>Pots offerts disponibles</span><strong>{{ loyalty.rewards_available }}</strong></div>
                        <div><span>Progression</span><strong>{{ loyalty.pots_in_progress }} / {{ loyalty.pots_per_reward }}</strong></div>
                        <div><span>Avant le prochain</span><strong>{{ loyalty.pots_until_next }} pot{{ loyalty.pots_until_next > 1 ? 's' : '' }}</strong></div>
                    </div>
                    <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post">
                        <input type="hidden" name="action" value="luziapi_adjust_loyalty_pots">
                        <input type="hidden" name="_wpnonce" value="{{ adjust_pots_nonce|e('html_attr') }}">
                        <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                        <label for="luziapi-pots-amount"><strong>Ajuster le solde de pots</strong></label>
                        <select name="pots_direction" aria-label="Sens de l’ajustement"><option value="add">Ajouter</option><option value="remove">Retirer</option></select>
                        <input id="luziapi-pots-amount" type="number" name="pots_amount" min="1" value="1" aria-label="Nombre de pots">
                        <input type="text" name="pots_reason" placeholder="Motif (ex. geste commercial)" aria-label="Motif">
                        <button class="button" type="submit">Ajuster</button>
                    </form>
                    {% if merge_candidates %}
                        <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post" onsubmit="return confirm('Fusionner ces deux clients ? Leurs pots de fidélité seront regroupés.');">
                            <input type="hidden" name="action" value="luziapi_merge_loyalty_customers">
                            <input type="hidden" name="_wpnonce" value="{{ merge_nonce|e('html_attr') }}">
                            <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                            <label for="luziapi-merge-target"><strong>Fusionner avec un autre client</strong> <span class="description">(même personne, autre e-mail ou numéro)</span></label>
                            <select id="luziapi-merge-target" name="merge_target" aria-label="Client à fusionner avec celui-ci">
                                <option value="">Choisir un client de la liste…</option>
                                {% for candidate in merge_candidates %}<option value="{{ candidate.id|e('html_attr') }}">{{ candidate.name|e }}</option>{% endfor %}
                            </select>
                            <button class="button" type="submit">Fusionner</button>
                        </form>
                    {% endif %}
                    {% if customer_is_linked %}
                        <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post" onsubmit="return confirm('Détacher ce client du regroupement ? Ses pots ne seront plus agrégés avec les autres identités.');">
                            <input type="hidden" name="action" value="luziapi_unlink_loyalty_customer">
                            <input type="hidden" name="_wpnonce" value="{{ unlink_nonce|e('html_attr') }}">
                            <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                            <label><strong>Regroupement d’identités</strong> <span class="description">(ce client est fusionné avec d’autres)</span></label>
                            <button class="button" type="submit">Détacher ce client</button>
                        </form>
                    {% endif %}
                    {% if loyalty.entries %}
                        <div class="luziapi-pilotage__table-wrap">
                            <table class="widefat striped">
                                <thead><tr><th>Date</th><th>Mouvement</th><th>Pots</th><th>Détail</th></tr></thead>
                                <tbody>
                                {% for entry in loyalty.entries %}
                                    <tr>
                                        <td>{{ entry.date|e }}</td>
                                        <td>{{ entry.label|e }}</td>
                                        <td>{{ entry.pots|e }}</td>
                                        <td>{{ entry.reason|e }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p>Aucun pot crédité pour l’instant.</p>
                    {% endif %}
                </div>
            {% endif %}
            <h3>Historique complet</h3>
            <div class="luziapi-pilotage__table-wrap">
                <table class="widefat striped">
                    <thead><tr><th>Commande</th><th>Date</th><th>Statut</th><th>Total</th></tr></thead>
                    <tbody>
                    {% for order in selected_customer.orders %}
                        <tr>
                            <td><a href="{{ order.url|e('html_attr') }}"><strong>n°{{ order.number|e }}</strong></a></td>
                            <td>{{ order.date|e }}</td>
                            <td>{{ order.status|e }}</td>
                            <td>{{ order.total|e }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <h3>Remise remerciement</h3>
            <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post">
                <input type="hidden" name="action" value="luziapi_apply_thankyou_discount">
                <input type="hidden" name="_wpnonce" value="{{ discount_nonce|e('html_attr') }}">
                <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                <label for="luziapi-discount-order"><strong>Commande</strong></label>
                <select id="luziapi-discount-order" name="order_id" required>{% for order in selected_customer.orders %}<option value="{{ order.id }}">n°{{ order.number|e }} — {{ order.date|e }} — {{ order.total|e }} ({{ order.status|e }})</option>{% endfor %}</select>
                <select name="discount_type" required><option value="percent">En %</option><option value="amount">En €</option></select>
                <input type="number" name="discount_value" min="0" step="0.01" value="0" required aria-label="Valeur de la remise">
                <button class="button button-primary" type="submit">Appliquer la remise</button>
            </form>
            <p class="description">Geste commercial libre. Si la commande était déjà encaissée, la recette est corrigée automatiquement.</p>
            <h3>Notes et échanges</h3>
            <div class="luziapi-pilotage__timeline">
                {% for event in timeline %}<article><div><span class="luziapi-pilotage__badge {{ event.public ? 'is-public' : 'is-private' }}">{{ event.visibility|e }}</span><time>{{ event.date|e }}</time> · <a href="{{ event.order_url|e('html_attr') }}">commande n°{{ event.order_number|e }}</a></div><p>{{ event.content|e }}</p></article>{% else %}<p>Aucune note enregistrée pour ces commandes.</p>{% endfor %}
            </div>
        </section>
        <script>
        (function () {
            // Autocomplétion d'adresse via notre endpoint admin-ajax, qui interroge la
            // Base Adresse Nationale côté serveur (harmonisation centralisée). Amélioration
            // progressive : si l'endpoint ne répond pas, la saisie manuelle reste possible.
            var input = document.querySelector('input[data-luziapi-address]');
            if (!input || !window.fetch || typeof ajaxurl === 'undefined') { return; }
            var nonce = input.getAttribute('data-luziapi-address-nonce') || '';
            var form = input.form;
            var postcode = form.querySelector('[data-luziapi-postcode]');
            var city = form.querySelector('[data-luziapi-city]');
            var country = form.querySelector('input[name="billing_country"]');
            var box = document.createElement('ul');
            box.style.cssText = 'list-style:none;margin:2px 0 0;padding:0;border:1px solid #dcdcde;border-radius:4px;background:#fff;position:absolute;z-index:100;max-height:220px;overflow:auto;box-shadow:0 2px 6px rgba(0,0,0,.12);min-width:280px;display:none';
            input.parentNode.style.position = 'relative';
            input.parentNode.appendChild(box);
            var timer = null;

            function hide() { box.style.display = 'none'; box.innerHTML = ''; }

            function pick(item) {
                input.value = item.street || item.label || input.value;
                if (postcode && item.postcode) { postcode.value = item.postcode; }
                if (city && item.city) { city.value = item.city; }
                if (country && !country.value) { country.value = 'FR'; }
                hide();
            }

            function render(items) {
                box.innerHTML = '';
                if (!items.length) { hide(); return; }
                items.forEach(function (item) {
                    var li = document.createElement('li');
                    li.textContent = item.label;
                    li.style.cssText = 'padding:6px 10px;cursor:pointer;font-size:13px';
                    li.addEventListener('mousedown', function (e) { e.preventDefault(); pick(item); });
                    li.addEventListener('mouseenter', function () { li.style.background = '#f0f0f1'; });
                    li.addEventListener('mouseleave', function () { li.style.background = '#fff'; });
                    box.appendChild(li);
                });
                box.style.display = 'block';
            }

            input.addEventListener('input', function () {
                var q = input.value.trim();
                if (timer) { clearTimeout(timer); }
                if (q.length < 3) { hide(); return; }
                timer = setTimeout(function () {
                    var url = ajaxurl + '?action=luziapi_address_search&_ajax_nonce=' + encodeURIComponent(nonce) + '&q=' + encodeURIComponent(q);
                    fetch(url, { credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (res) { if (res && res.success && Array.isArray(res.data)) { render(res.data); } else { hide(); } })
                        .catch(function () { hide(); });
                }, 250);
            });
            input.addEventListener('blur', function () { setTimeout(hide, 150); });
        })();
        </script>
    {% endif %}

    <section class="luziapi-pilotage__panel luziapi-pilotage__customers">
        <div class="luziapi-pilotage__panel-header">
            <div>
                <p class="luziapi-pilotage__eyebrow">Répertoire commercial</p>
                <h2>{{ total_customers }} client{{ total_customers > 1 ? 's' : '' }}</h2>
            </div>
            <form class="luziapi-pilotage__search" action="{{ page_url|e('html_attr') }}" method="get">
                <input type="hidden" name="page" value="luziapi-pilotage">
                <input type="hidden" name="tab" value="customers">
                <label class="screen-reader-text" for="luziapi-customer-category-filter">Filtrer par catégorie</label>
                <select id="luziapi-customer-category-filter" name="category"><option value="">Toutes les catégories</option>{% for category in categories %}<option value="{{ category.value|e('html_attr') }}" {{ category.value == selected_category ? 'selected' : '' }}>{{ category.label|e }}</option>{% endfor %}</select>
                <label class="screen-reader-text" for="luziapi-customer-search">Rechercher un client</label>
                <input id="luziapi-customer-search" name="s" type="search" value="{{ search|e('html_attr') }}" placeholder="Nom, e-mail ou téléphone">
                <button class="button" type="submit">Rechercher</button>
            </form>
        </div>

        <div class="luziapi-pilotage__table-wrap">
            <table class="widefat striped">
                <thead><tr><th>Client</th><th>Catégorie</th><th>Coordonnées</th><th>Dernière commande</th><th>Commandes</th><th>Total</th></tr></thead>
                <tbody>
                {% for customer in customers %}
                    <tr>
                        <td>
                            <a href="{{ customer.details_url|e('html_attr') }}"><strong>{{ customer.name|e }}</strong></a>
                            {% if customer.city %}<br>{{ customer.city|e }}{% endif %}
                        </td>
                        <td><span class="luziapi-pilotage__badge is-customer-category">{{ customer.category|e }}</span></td>
                        <td>
                            {% for email in customer.emails %}<a href="mailto:{{ email|e('html_attr') }}">{{ email|e }}</a><br>{% endfor %}
                            {% for phone in customer.phones %}<a href="tel:{{ phone.href|e('html_attr') }}">{{ phone.label|e }}</a><br>{% endfor %}
                        </td>
                        <td><a href="{{ customer.last_order.url|e('html_attr') }}">n°{{ customer.last_order.number|e }}</a><br>{{ customer.last_order.date|e }}</td>
                        <td>{{ customer.orders_count }}</td>
                        <td>{{ customer.total|e }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Aucun client trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if pagination %}<div class="tablenav"><div class="tablenav-pages">{{ pagination|raw }}</div></div>{% endif %}
    </section>
</div>
