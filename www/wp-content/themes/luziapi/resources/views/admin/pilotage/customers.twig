<div class="wrap luziapi-pilotage">
    <div class="luziapi-pilotage__header">
        <div>
            <p class="luziapi-pilotage__eyebrow">Carnet client</p>
            <h1>Clients et historique</h1>
            <p>Historique construit depuis les commandes, sans créer de compte ni de consentement marketing.</p>
        </div>
        <a class="page-title-action" href="{{ new_order_url|e('html_attr') }}">Ajouter une commande</a>
    </div>

    <nav class="nav-tab-wrapper" aria-label="Sections du tableau de pilotage">
        <a class="nav-tab" href="{{ dashboard_url|e('html_attr') }}">Vue d’ensemble</a>
        <a class="nav-tab" href="{{ receipts_url|e('html_attr') }}">Recettes</a>
        <a class="nav-tab" href="{{ tax_declaration_url|e('html_attr') }}">Déclaration fiscale</a>
        <a class="nav-tab" href="{{ orders_url|e('html_attr') }}">Commandes</a>
        <a class="nav-tab nav-tab-active" href="{{ page_url|e('html_attr') }}">Clients</a>
        <a class="nav-tab" href="{{ products_url|e('html_attr') }}">Produits</a>
        <a class="nav-tab" href="{{ inventory_url|e('html_attr') }}">Stocks et lots</a>
        <a class="nav-tab" href="{{ quick_sale_url|e('html_attr') }}">Vente</a>
        <a class="nav-tab" href="{{ activity_url|e('html_attr') }}">Journal d’activité</a>
    </nav>

    {% if notice == 'category_updated' %}<div class="notice notice-success inline"><p>La catégorie du client a été enregistrée.</p></div>{% endif %}
    {% if notice == 'category_error' %}<div class="notice notice-error inline"><p>La catégorie n’a pas pu être enregistrée. Recharge la fiche et réessaie.</p></div>{% endif %}
    {% if notice == 'discount_applied' %}<div class="notice notice-success inline"><p>La remise remerciement a été appliquée à la commande.</p></div>{% endif %}
    {% if notice == 'discount_error' %}<div class="notice notice-error inline"><p>La remise remerciement n’a pas pu être appliquée. Vérifie la commande et le montant.</p></div>{% endif %}

    {% if selected_customer %}
        <section class="luziapi-pilotage__customer-card">
            <div class="luziapi-pilotage__panel-header">
                <div>
                    <p class="luziapi-pilotage__eyebrow">Fiche client</p>
                    <h2>{{ selected_customer.name|e }}</h2>
                    {% if selected_customer.city %}<p>{{ selected_customer.city|e }}</p>{% endif %}
                </div>
                <div class="luziapi-pilotage__panel-actions">
                    <a class="button button-primary" href="{{ new_order_for_customer_url|e('html_attr') }}">Créer une vente pour ce client</a>
                    <a class="button" href="{{ page_url|e('html_attr') }}">Fermer la fiche</a>
                </div>
            </div>
            <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post">
                <input type="hidden" name="action" value="luziapi_assign_customer_category">
                <input type="hidden" name="_wpnonce" value="{{ category_nonce|e('html_attr') }}">
                <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                <label for="luziapi-customer-category"><strong>Catégorie du client</strong></label>
                <select id="luziapi-customer-category" name="category">{% for category in categories %}<option value="{{ category.value|e('html_attr') }}" {{ category.value == selected_customer.category_key ? 'selected' : '' }}>{{ category.label|e }}</option>{% endfor %}</select>
                <button class="button button-primary" type="submit">Enregistrer la catégorie</button>
            </form>
            <div class="luziapi-pilotage__customer-summary">
                <div><span>Commandes validées</span><strong>{{ selected_customer.orders_count }}</strong></div>
                <div><span>Total commandé</span><strong>{{ selected_customer.total|e }}</strong></div>
                <div><span>Total encaissé</span><strong>{{ selected_customer.collected|e }}</strong></div>
                <div>
                    <span>Coordonnées</span>
                    {% for email in selected_customer.emails %}<a href="mailto:{{ email|e('html_attr') }}">{{ email|e }}</a>{% endfor %}
                    {% for phone in selected_customer.phones %}<a href="tel:{{ phone.href|e('html_attr') }}">{{ phone.label|e }}</a>{% endfor %}
                </div>
            </div>
            <div class="luziapi-pilotage__customer-insights">
                <p><strong>Produits habituels :</strong> {{ selected_customer.products ? selected_customer.products|join(', ')|e : 'Pas encore assez de données' }}</p>
                <p><strong>Sources :</strong> {{ selected_customer.sources ? selected_customer.sources|join(', ')|e : 'Non renseignée' }}</p>
            </div>
            {% if selected_customer.loyalty %}
                {% set loyalty = selected_customer.loyalty %}
                <div class="luziapi-pilotage__loyalty">
                    <h3>Fidélité</h3>
                    <div class="luziapi-pilotage__customer-summary">
                        <div><span>Pots fidélité</span><strong>{{ loyalty.net_pots }}</strong></div>
                        <div><span>Pots offerts disponibles</span><strong>{{ loyalty.rewards_available }}</strong></div>
                        <div><span>Progression</span><strong>{{ loyalty.pots_in_progress }} / {{ loyalty.pots_per_reward }}</strong></div>
                        <div><span>Avant le prochain</span><strong>{{ loyalty.pots_until_next }} pot{{ loyalty.pots_until_next > 1 ? 's' : '' }}</strong></div>
                    </div>
                    {% if loyalty.entries %}
                        <div class="luziapi-pilotage__table-wrap">
                            <table class="widefat striped">
                                <thead><tr><th>Date</th><th>Mouvement</th><th>Pots</th><th>Détail</th></tr></thead>
                                <tbody>
                                {% for entry in loyalty.entries %}
                                    <tr>
                                        <td>{{ entry.date|e }}</td>
                                        <td>{{ entry.label|e }}</td>
                                        <td>{{ entry.pots|e }}</td>
                                        <td>{{ entry.reason|e }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p>Aucun pot crédité pour l’instant.</p>
                    {% endif %}
                </div>
            {% endif %}
            <h3>Historique complet</h3>
            <div class="luziapi-pilotage__table-wrap">
                <table class="widefat striped">
                    <thead><tr><th>Commande</th><th>Date</th><th>Statut</th><th>Total</th></tr></thead>
                    <tbody>
                    {% for order in selected_customer.orders %}
                        <tr>
                            <td><a href="{{ order.url|e('html_attr') }}"><strong>n°{{ order.number|e }}</strong></a></td>
                            <td>{{ order.date|e }}</td>
                            <td>{{ order.status|e }}</td>
                            <td>{{ order.total|e }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <h3>Remise remerciement</h3>
            <form class="luziapi-pilotage__customer-category-form" action="{{ action_url|e('html_attr') }}" method="post">
                <input type="hidden" name="action" value="luziapi_apply_thankyou_discount">
                <input type="hidden" name="_wpnonce" value="{{ discount_nonce|e('html_attr') }}">
                <input type="hidden" name="customer_id" value="{{ selected_customer.id|e('html_attr') }}">
                <label for="luziapi-discount-order"><strong>Commande</strong></label>
                <select id="luziapi-discount-order" name="order_id" required>{% for order in selected_customer.orders %}<option value="{{ order.id }}">n°{{ order.number|e }} — {{ order.date|e }} — {{ order.total|e }} ({{ order.status|e }})</option>{% endfor %}</select>
                <select name="discount_type" required><option value="percent">En %</option><option value="amount">En €</option></select>
                <input type="number" name="discount_value" min="0" step="0.01" value="0" required aria-label="Valeur de la remise">
                <button class="button button-primary" type="submit">Appliquer la remise</button>
            </form>
            <p class="description">Geste commercial libre. Si la commande était déjà encaissée, la recette est corrigée automatiquement.</p>
            <h3>Notes et échanges</h3>
            <div class="luziapi-pilotage__timeline">
                {% for event in timeline %}<article><div><span class="luziapi-pilotage__badge {{ event.public ? 'is-public' : 'is-private' }}">{{ event.visibility|e }}</span><time>{{ event.date|e }}</time> · <a href="{{ event.order_url|e('html_attr') }}">commande n°{{ event.order_number|e }}</a></div><p>{{ event.content|e }}</p></article>{% else %}<p>Aucune note enregistrée pour ces commandes.</p>{% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="luziapi-pilotage__panel luziapi-pilotage__customers">
        <div class="luziapi-pilotage__panel-header">
            <div>
                <p class="luziapi-pilotage__eyebrow">Répertoire commercial</p>
                <h2>{{ total_customers }} client{{ total_customers > 1 ? 's' : '' }}</h2>
            </div>
            <form class="luziapi-pilotage__search" action="{{ page_url|e('html_attr') }}" method="get">
                <input type="hidden" name="page" value="luziapi-pilotage">
                <input type="hidden" name="tab" value="customers">
                <label class="screen-reader-text" for="luziapi-customer-category-filter">Filtrer par catégorie</label>
                <select id="luziapi-customer-category-filter" name="category"><option value="">Toutes les catégories</option>{% for category in categories %}<option value="{{ category.value|e('html_attr') }}" {{ category.value == selected_category ? 'selected' : '' }}>{{ category.label|e }}</option>{% endfor %}</select>
                <label class="screen-reader-text" for="luziapi-customer-search">Rechercher un client</label>
                <input id="luziapi-customer-search" name="s" type="search" value="{{ search|e('html_attr') }}" placeholder="Nom, e-mail ou téléphone">
                <button class="button" type="submit">Rechercher</button>
            </form>
        </div>

        <div class="luziapi-pilotage__table-wrap">
            <table class="widefat striped">
                <thead><tr><th>Client</th><th>Catégorie</th><th>Coordonnées</th><th>Dernière commande</th><th>Commandes</th><th>Total</th></tr></thead>
                <tbody>
                {% for customer in customers %}
                    <tr>
                        <td>
                            <a href="{{ customer.details_url|e('html_attr') }}"><strong>{{ customer.name|e }}</strong></a>
                            {% if customer.city %}<br>{{ customer.city|e }}{% endif %}
                        </td>
                        <td><span class="luziapi-pilotage__badge is-customer-category">{{ customer.category|e }}</span></td>
                        <td>
                            {% for email in customer.emails %}<a href="mailto:{{ email|e('html_attr') }}">{{ email|e }}</a><br>{% endfor %}
                            {% for phone in customer.phones %}<a href="tel:{{ phone.href|e('html_attr') }}">{{ phone.label|e }}</a><br>{% endfor %}
                        </td>
                        <td><a href="{{ customer.last_order.url|e('html_attr') }}">n°{{ customer.last_order.number|e }}</a><br>{{ customer.last_order.date|e }}</td>
                        <td>{{ customer.orders_count }}</td>
                        <td>{{ customer.total|e }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Aucun client trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if pagination %}<div class="tablenav"><div class="tablenav-pages">{{ pagination|raw }}</div></div>{% endif %}
    </section>
</div>
